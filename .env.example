# =====================================================================
# FilmLink backend - MAU bien moi truong. Chep thanh .env (cung thu muc) roi dien gia tri cua ban.
# .env KHONG duoc commit (.gitignore da chan). File mau nay KHONG chua mat khau.
#
# Dinh dang: KEY=VALUE, moi dong mot bien.
#   - KHONG dung dau nhay:        DB_PASSWORD=abc123   (dung)
#                                 DB_PASSWORD="abc123" (sai - dau nhay thanh mot phan mat khau)
#   - Dong bat dau bang # la ghi chu.
#   - Neu mat khau co dau \ thi viet thanh \\
# Bien moi truong cua Windows (setx) neu co se DE LEN gia tri trong file nay.
# =====================================================================

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/postgres

# Schema trong database tren. Flyway tu tao neu chua co.
# App chay tren DB_SCHEMA; test (mvnw verify) chay tren DB_TEST_SCHEMA - tach rieng de test khong dung du lieu dev.
DB_SCHEMA=filmlink_local
DB_TEST_SCHEMA=filmlink_test
DB_USERNAME=postgres
DB_PASSWORD=admin

# --- Swagger (true o local, false khi deploy) ---
SWAGGER_ENABLED=true

# --- Server ---
# SERVER_PORT=8386

# --- JWT (UC01, NFR-SEC-01) ---
# BAT BUOC. Khoa HS256 dang Base64, toi thieu 256 bit (32 byte). Moi may tu sinh, KHONG dung chung, KHONG commit.
# Sinh bang PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=
# Thoi han token (ISO-8601 Duration). Mac dinh: access 15 phut, refresh 7 ngay.
# JWT_ACCESS_TOKEN_TTL=PT15M
# JWT_REFRESH_TOKEN_TTL=P7D

# --- Email ---
# log = chi ghi email (ke ca OTP) ra log, dung o may local. Chua co provider SMTP.
MAIL_PROVIDER=log

# --- CORS: origin FE duoc goi API, phan tach dau phay ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- VNPay sandbox (SPIKE, chua noi Service Order) ---
# De trong thi POST /api/v1/payments/vnpay/sandbox-url tra 503; app van khoi dong.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=

# --- Storage (client/storage, NFR-PRI-02) ---
# local = luu file trong thu muc STORAGE_LOCAL_ROOT tren may dev. Azure Blob them sau.
STORAGE_PROVIDER=local
# BAT BUOC khi STORAGE_PROVIDER=local. App tu tao thu muc neu chua co.
# .env duoc doc nhu file .properties: dau \ la ky tu escape (D:\FPT_U thanh D:FPT_U).
# Duong dan Windows PHAI viet bang dau /, vi du: D:/FPT_U/DoAnTotNghiep/filmlink-storage
STORAGE_LOCAL_ROOT=
# CHI BAT BUOC khi STORAGE_PROVIDER=local (trong thi app khong khoi dong). Provider khac thi de trong duoc.
# Khoa HMAC-SHA256 ky link tai file, Base64 toi thieu 256 bit, RIENG voi JWT_SECRET. Sinh bang PowerShell 5.1:
#   $b = New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
STORAGE_SIGNING_SECRET=
# Thoi han link tai (ISO-8601 Duration), toi da 15 phut.
# STORAGE_SIGNED_URL_TTL=PT15M
# Goc URL backend de dung link tai. Mac dinh http://localhost:<SERVER_PORT>.
# CHI bo comment khi can doi, KHONG de trong (KEY= la chuoi rong, link tai se hong).
# STORAGE_PUBLIC_BASE_URL=

# --- OpenAI (client/llm, Advisory Chatbot UC19) ---
# De TRONG thi chatbot tra cau tra loi du phong (fallback), app va test van chay. KHONG commit key that.
OPENAI_API_KEY=
# Model chat. Model embedding doc tu tham so he thong EMBEDDING_MODEL, khong dat o day.
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Email SMTP (client/notification, chi dung khi MAIL_PROVIDER=smtp) ---
# Tai khoan / mat khau de TRONG; dien gia tri that chi trong .env (KHONG commit).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
MAIL_FROM=noreply@filmlink.vn
MAIL_FROM_NAME=FilmLink

# --- Delivery Partner (client/delivery, UC21) ---
# GHN tat mac dinh: app va test khoi dong khong can bien GHN_*. Bat thi dien du token, shop id, webhook secret.
GHN_ENABLED=false
DELIVERY_PROVIDER=ghn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=

# --- Google Maps Platform (delivery domain, DEL-GEO-01) ---
# Lay tu Google Cloud Console -> APIs & Services -> Credentials.
# De trong thi cac endpoint /api/v1/delivery/geocoding tra 503; app van khoi dong binh thuong.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_CONNECT_TIMEOUT_MS=3000
# GOOGLE_MAPS_MAX_RETRIES=3
